{
  "name": "create-react-bp",
  "version": "1.1.0",
  "description": "React 앱 생성 CLI (Chakra UI 또는 Ant Design Admin 템플릿)",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "boilerplate",
    "scaffold",
    "generator",
    "cli",
    "vite",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blue45f/react-boilerplates",
    "directory": "packages/cli/create-app"
  },
  "bin": {
    "create-react-bp": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "^5.6.0",
    "commander": "^14.0.0",
    "fs-extra": "^11.3.2",
    "ora": "^9.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.7"
  }
}
