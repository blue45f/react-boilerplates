{
  "name": "create-react-lib",
  "version": "1.1.0",
  "description": "React 컴포넌트 라이브러리 생성 CLI (Vite library mode + Vitest + Storybook 준비)",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "library",
    "component",
    "scaffold",
    "generator",
    "cli",
    "vite",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blue45f/react-boilerplates",
    "directory": "packages/cli/create-lib"
  },
  "bin": {
    "create-react-lib": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fs-extra": "^11.3.5",
    "ora": "^9.4.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.4.1",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
