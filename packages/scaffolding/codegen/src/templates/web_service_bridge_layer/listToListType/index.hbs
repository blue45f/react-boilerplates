import React, { useState } from 'react'
import { Card, Button, Space, Typography, Form, Input, Table, Modal, Empty } from 'antd'
import { PlusOutlined, DeleteOutlined, CloseOutlined } from '@ant-design/icons'
import type { ColumnsType } from 'antd/es/table'

const { Title, Text } = Typography

interface DataType {
  key: string
  sampleId: string
  sampleName: string
  sampleData: string
}

interface Props {
  content?: string
}

const {{convertName name feature}}: React.FC<Props> = ({ content = '내용을 입력하세요' }) => {
  const [isSelectModalOpen, setIsSelectModalOpen] = useState<boolean>(false)
  const [selectedRowKeys, setSelectedRowKeys] = useState<React.Key[]>([])
  const [dataSource, setDataSource] = useState<DataType[]>(DUMMY_DATA)
  const [form] = Form.useForm()

  const handleBackButtonClick = () => {
    /* 취소 버튼 클릭 시 처리 */
  }

  const handleSaveButtonClick = () => {
    /* 저장 버튼 클릭 시 처리 */
    form.validateFields().then((values) => {
      console.log('Form values:', values)
    })
  }

  const openSelectModal = () => {
    setIsSelectModalOpen(true)
  }

  const closeSelectModal = () => {
    setIsSelectModalOpen(false)
  }

  const removeSelectedItems = () => {
    setDataSource(dataSource.filter((item) => !selectedRowKeys.includes(item.key)))
    setSelectedRowKeys([])
  }

  const columns: ColumnsType<DataType> = [
    {
      title: '샘플 아이디',
      dataIndex: 'sampleId',
      key: 'sampleId',
      width: 100,
    },
    {
      title: '샘플 이름',
      dataIndex: 'sampleName',
      key: 'sampleName',
      width: 200,
    },
    {
      title: '샘플 데이터',
      dataIndex: 'sampleData',
      key: 'sampleData',
      width: 200,
    },
  ]

  const rowSelection = {
    selectedRowKeys,
    onChange: (keys: React.Key[]) => {
      setSelectedRowKeys(keys)
    },
  }

  const ActionButtons = () => (
    <Space>
      <Button onClick={handleBackButtonClick}>취소</Button>
      <Button type="primary" onClick={handleSaveButtonClick}>저장</Button>
    </Space>
  )

  return (
    <div style=\{{ padding: '24px' }}>
      <Form form={form} layout="vertical">
        {/* Page Header */}
        <div style=\{{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 24 }}>
          <div>
            <Title level={3} style=\{{ marginBottom: 8 }}>List to List형 페이지</Title>
            <Text type="secondary">List to List형 페이지입니다.</Text>
          </div>
          <ActionButtons />
        </div>

        <Card title="카드 타이틀" style=\{{ marginBottom: 24 }}>
          <Form.Item
            label="라벨"
            name="sampleData"
            rules={[{ required: true, message: '필수 입력 항목입니다' }]}
          >
            <Input placeholder="플레이스홀더" style=\{{ maxWidth: 600 }} />
          </Form.Item>
        </Card>

        <div style=\{{ marginBottom: 16 }}>
          <div style=\{{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>
            <Space>
              <Title level={5} style=\{{ margin: 0 }}>선택된 아이템 목록</Title>
              <Text type="secondary">총 {dataSource.length}개</Text>
            </Space>
            <Space>
              <Button
                icon={<DeleteOutlined />}
                onClick={removeSelectedItems}
                disabled={selectedRowKeys.length === 0}
              >
                선택 삭제
              </Button>
              <Button type="primary" icon={<PlusOutlined />} onClick={openSelectModal}>
                아이템 추가
              </Button>
            </Space>
          </div>

          <Table
            rowSelection={rowSelection}
            columns={columns}
            dataSource={dataSource}
            pagination={false}
            scroll=\{{ y: 400 }}
            locale=\{{
              emptyText: (
                <Empty description="선택된 아이템이 없습니다.">
                  <Button type="primary" icon={<PlusOutlined />} onClick={openSelectModal}>
                    아이템 추가
                  </Button>
                </Empty>
              ),
            }}
          />
        </div>

        <Modal
          title="아이템 선택"
          open={isSelectModalOpen}
          onCancel={closeSelectModal}
          footer={null}
          width={800}
          closeIcon={<CloseOutlined />}
        >
          {/* TODO: 아이템 추가를 위한 테이블 등을 구현해주세요. */}
          <Empty description="아이템 선택 영역입니다. 필요한 컴포넌트를 구현해주세요." />
        </Modal>
      </Form>
    </div>
  )
}

export default {{convertName name feature}}

const DUMMY_DATA: DataType[] = [
  {
    key: '1',
    sampleId: '1',
    sampleName: '샘플 이름',
    sampleData: '샘플 데이터',
  },
  {
    key: '2',
    sampleId: '2',
    sampleName: '샘플 이름2',
    sampleData: '샘플 데이터2',
  },
  {
    key: '3',
    sampleId: '3',
    sampleName: '샘플 이름3',
    sampleData: '샘플 데이터3',
  },
]
