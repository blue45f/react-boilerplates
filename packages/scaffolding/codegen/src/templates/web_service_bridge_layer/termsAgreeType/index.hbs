import React, { useState } from 'react'
import { Card, Button, Typography, Checkbox, Divider, Space } from 'antd'
import type { CheckboxChangeEvent } from 'antd/es/checkbox'

const { Title, Text } = Typography

const TermsAgreePage: React.FC = () => {
  const [isAllChecked, setIsAllChecked] = useState(false)
  const [isRequiredChecked, setIsRequiredChecked] = useState({
    terms: false,
    privacy: false,
  })
  const [isOptionalChecked, setIsOptionalChecked] = useState({
    optionalTerms: false,
    adConsent: false,
    sms: false,
    email: false,
    phone: false,
    adConsent2: false,
    sms2: false,
    email2: false,
    PrivacyAgreement: false,
  })

  const handleAllChecked = (e: CheckboxChangeEvent) => {
    const newState = e.target.checked
    setIsAllChecked(newState)

    setIsRequiredChecked({
      terms: newState,
      privacy: newState,
    })

    setIsOptionalChecked({
      optionalTerms: newState,
      adConsent: newState,
      sms: newState,
      email: newState,
      phone: newState,
      adConsent2: newState,
      sms2: newState,
      email2: newState,
      PrivacyAgreement: newState,
    })
  }

  const handleRequiredChecked = (key: 'terms' | 'privacy') => (e: CheckboxChangeEvent) => {
    const newState = { ...isRequiredChecked, [key]: e.target.checked }
    setIsRequiredChecked(newState)

    const allRequiredChecked = Object.values(newState).every((v) => v)
    const allOptionalChecked = Object.values(isOptionalChecked).every((v) => v)
    setIsAllChecked(allRequiredChecked && allOptionalChecked)
  }

  const handleOptionalChecked = (key: keyof typeof isOptionalChecked) => (e: CheckboxChangeEvent) => {
    const newState = { ...isOptionalChecked, [key]: e.target.checked }
    setIsOptionalChecked(newState)

    const allOptionalChecked = Object.values(newState).every((v) => v)
    const allRequiredChecked = Object.values(isRequiredChecked).every((v) => v)
    setIsAllChecked(allOptionalChecked && allRequiredChecked)
  }

  return (
    <div style=\{{
      width: '100%',
      minHeight: '100vh',
      display: 'flex',
      justifyContent: 'center',
      alignItems: 'center',
      background: '#f5f5f5',
    }}>
      <Card style=\{{ width: 552, padding: '24px' }}>
        <Space direction="vertical" size="large" style=\{{ width: '100%' }}>
          <div>
            <Title level={4} style=\{{ marginBottom: 8 }}>
              안녕하세요, 서비스 이용을 위한 <br />
              약관 동의가 필요합니다.
            </Title>
            <Text type="secondary">
              회원이 되시면 다양한 서비스를 편안하게 이용할 수 있어요.
            </Text>
          </div>

          <Card size="small" style=\{{ background: '#fafafa' }}>
            <Checkbox checked={isAllChecked} onChange={handleAllChecked}>
              <Text strong>전체 동의</Text>
            </Checkbox>
          </Card>

          <div>
            <Text strong style=\{{ display: 'block', marginBottom: 12 }}>
              서비스 이용을 위한 동의가 필요합니다
            </Text>
            <Space direction="vertical">
              <Checkbox
                checked={isRequiredChecked.terms}
                onChange={handleRequiredChecked('terms')}
              >
                [필수] 이용약관 동의
              </Checkbox>
              <Checkbox
                checked={isRequiredChecked.privacy}
                onChange={handleRequiredChecked('privacy')}
              >
                [필수] 개인정보 수집 이용동의
              </Checkbox>
            </Space>
          </div>

          <div>
            <Text strong style=\{{ display: 'block', marginBottom: 12 }}>
              특별한 혜택과 최신 소식을 받아보세요
            </Text>
            <Space direction="vertical">
              <Checkbox
                checked={isOptionalChecked.optionalTerms}
                onChange={handleOptionalChecked('optionalTerms')}
              >
                [선택] 이용약관 동의
              </Checkbox>
              <Checkbox
                checked={isOptionalChecked.adConsent}
                onChange={handleOptionalChecked('adConsent')}
              >
                [선택] 광고성 정보 수신 동의
              </Checkbox>
              <div style=\{{ marginLeft: 24 }}>
                <Space>
                  <Checkbox
                    checked={isOptionalChecked.sms}
                    onChange={handleOptionalChecked('sms')}
                  >
                    SMS
                  </Checkbox>
                  <Checkbox
                    checked={isOptionalChecked.email}
                    onChange={handleOptionalChecked('email')}
                  >
                    이메일
                  </Checkbox>
                  <Checkbox
                    checked={isOptionalChecked.phone}
                    onChange={handleOptionalChecked('phone')}
                  >
                    전화
                  </Checkbox>
                </Space>
              </div>
              <Checkbox
                checked={isOptionalChecked.PrivacyAgreement}
                onChange={handleOptionalChecked('PrivacyAgreement')}
              >
                [선택] 회원 연동을 위한 개인정보 수집 이용 동의
              </Checkbox>
            </Space>
          </div>

          <Button type="primary" size="large" block>
            다음
          </Button>
        </Space>
      </Card>
    </div>
  )
}

export default TermsAgreePage
