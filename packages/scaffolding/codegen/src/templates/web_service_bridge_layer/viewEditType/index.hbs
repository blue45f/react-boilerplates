import React, { useState } from 'react'
import { Card, Button, Space, Typography, Form, Input, Descriptions } from 'antd'
import { EditOutlined } from '@ant-design/icons'

const { Title, Text } = Typography

interface Props {
  content?: string
}

const {{convertName name feature}}: React.FC<Props> = ({ content = '내용을 입력하세요' }) => {
  const [visibleMode, setVisibleMode] = useState<'view' | 'edit'>('view')
  const [form] = Form.useForm()

  const onSubmit = (values: any) => {
    console.log('Form values:', values)
    setVisibleMode('view')
  }

  const onCancel = () => {
    form.resetFields()
    setVisibleMode('view')
  }

  // View Mode
  const ViewMode = () => (
    <Card
      title="카드 타이틀"
      extra={
        <Button icon={<EditOutlined />} onClick={() => setVisibleMode('edit')}>
          수정
        </Button>
      }
    >
      <Descriptions column={1} bordered>
        <Descriptions.Item label="라벨1">
          <Text>입력해주세요.</Text>
        </Descriptions.Item>
        <Descriptions.Item label="라벨2">
          <Text>입력해주세요.</Text>
        </Descriptions.Item>
      </Descriptions>
    </Card>
  )

  // Edit Mode
  const EditMode = () => (
    <Card
      title="카드 타이틀"
      extra={
        <Space>
          <Button onClick={onCancel}>취소</Button>
          <Button type="primary" onClick={() => form.submit()}>저장</Button>
        </Space>
      }
    >
      <Form form={form} layout="vertical" onFinish={onSubmit}>
        <Form.Item
          label="라벨1"
          name="sample1"
          rules={[{ required: true, message: '필수 입력 항목입니다' }]}
        >
          <Input placeholder="sample placeholder" style=\{{ maxWidth: 600 }} />
        </Form.Item>
        <Form.Item label="라벨2" name="sample2">
          <Input placeholder="sample placeholder" style=\{{ maxWidth: 600 }} />
        </Form.Item>
      </Form>
    </Card>
  )

  return (
    <div style=\{{ padding: '24px' }}>
      {/* NOTE: Card를 2개 이상 사용할 경우, Space 컴포넌트를 사용해주세요 */}
      <Space direction="vertical" size="middle" style=\{{ width: '100%' }}>
        {visibleMode === 'view' ? <ViewMode /> : <EditMode />}
      </Space>
    </div>
  )
}

export default {{convertName name feature}}
