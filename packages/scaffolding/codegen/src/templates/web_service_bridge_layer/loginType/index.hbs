import React, { useState } from 'react'
import { Card, Typography, Input, Button, Checkbox, Divider, Badge, Space } from 'antd'
import { EyeOutlined, EyeInvisibleOutlined } from '@ant-design/icons'

const { Title, Text, Link } = Typography

const LoginPage: React.FC = () => {
  const [showPassword, setShowPassword] = useState(false)
  const [rememberMe, setRememberMe] = useState(false)

  return (
    <div style=\{{ width: '100%', minHeight: '100vh', display: 'flex', justifyContent: 'center', alignItems: 'center', background: '#f5f5f5' }}>
      <Card style=\{{ width: 552, padding: '32px' }}>
        <div style=\{{ textAlign: 'center', marginBottom: 32 }}>
          {/* 로고 이미지가 있는 경우 로고 이미지를 넣어주세요 */}
          <Space align="center">
            <Title level={2} style=\{{ marginBottom: 0 }}>어드민 서비스명</Title>
            <Badge count="베타" style=\{{ backgroundColor: '#ff4d4f' }} />
          </Space>
          <div style=\{{ marginTop: 8 }}>
            <Text type="secondary">어드민 로그인입니다</Text>
          </div>
        </div>

        <div style=\{{ width: '100%', maxWidth: 472, margin: '0 auto' }}>
          <div style=\{{ marginBottom: 16 }}>
            <Text>아이디</Text>
            <Input
              size="large"
              placeholder="아이디를 입력하세요"
              style=\{{ marginTop: 8 }}
            />
          </div>

          <div style=\{{ marginBottom: 24 }}>
            <Text>비밀번호</Text>
            <Input
              size="large"
              type={showPassword ? 'text' : 'password'}
              placeholder="비밀번호를 입력하세요"
              style=\{{ marginTop: 8 }}
              suffix={
                <Button
                  type="text"
                  size="small"
                  icon={showPassword ? <EyeInvisibleOutlined /> : <EyeOutlined />}
                  onClick={() => setShowPassword(!showPassword)}
                />
              }
            />
          </div>

          <Button type="primary" size="large" block>
            로그인
          </Button>

          <div style=\{{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginTop: 16 }}>
            <Checkbox
              checked={rememberMe}
              onChange={(e) => setRememberMe(e.target.checked)}
            >
              아이디 저장
            </Checkbox>
            <div>
              <Link>권한신청</Link>
              <Divider type="vertical" />
              <Link>아이디•비밀번호 찾기</Link>
            </div>
          </div>
        </div>
      </Card>
      {/* 서비스의 푸터를 넣어주세요 */}
    </div>
  )
}

export default LoginPage
