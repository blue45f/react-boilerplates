import React, { useState } from 'react'
import { Card, Button, Space, Typography, Upload, Alert, Form } from 'antd'
import { DownloadOutlined, SearchOutlined, UploadOutlined, InboxOutlined } from '@ant-design/icons'
import type { UploadFile, UploadProps } from 'antd'

const { Title, Text } = Typography
const { Dragger } = Upload

interface Props {
  content?: string
}

const {{convertName name feature}}: React.FC<Props> = ({ content = '내용을 입력하세요' }) => {
  const [fileList, setFileList] = useState<UploadFile[]>([])
  const [form] = Form.useForm()

  const uploadProps: UploadProps = {
    name: 'file',
    multiple: false,
    accept: '.xlsx,.xls,.csv',
    fileList,
    onChange(info) {
      setFileList(info.fileList.slice(-1))
    },
    beforeUpload: () => false, // Prevent auto upload
  }

  const onSubmit = () => {
    /* 저장 버튼 클릭 시 처리 */
    console.log('Submitted files:', fileList)
  }

  return (
    <div style=\{{ padding: '24px' }}>
      <Form form={form} layout="vertical" onFinish={onSubmit}>
        <Card
          title={<Title level={5}>일괄등록</Title>}
          style=\{{ marginBottom: 16 }}
        >
          <Space style=\{{ marginBottom: 24 }}>
            <Button icon={<DownloadOutlined />}>
              <a download="" href="">샘플 양식 다운로드</a>
            </Button>
            <Button icon={<SearchOutlined />}>
              샘플 검색 버튼
            </Button>
          </Space>

          <Alert
            message="확인해주세요!"
            description={
              <ul style=\{{ paddingLeft: 20, margin: 0 }}>
                <li>샘플 안내메시지입니다. 샘플 안내메시지입니다.</li>
                <li>샘플 안내메시지입니다. 샘플 안내메시지입니다.</li>
                <li>샘플 안내메시지입니다. 샘플 안내메시지입니다.</li>
              </ul>
            }
            type="info"
            showIcon
            style=\{{ marginBottom: 24 }}
          />

          <Form.Item
            label="일괄등록 파일 업로드"
            name="uploadFile"
            rules={[{ required: true, message: '파일을 업로드해주세요' }]}
          >
            <Dragger {...uploadProps}>
              <p className="ant-upload-drag-icon">
                <InboxOutlined />
              </p>
              <p className="ant-upload-text">클릭하거나 파일을 드래그하여 업로드</p>
              <p className="ant-upload-hint">
                Excel 파일(.xlsx, .xls) 또는 CSV 파일을 업로드해주세요
              </p>
            </Dragger>
          </Form.Item>
        </Card>

        <div style=\{{ textAlign: 'right' }}>
          <Button type="primary" htmlType="submit">
            일괄등록
          </Button>
        </div>
      </Form>
    </div>
  )
}

export default {{convertName name feature}}
