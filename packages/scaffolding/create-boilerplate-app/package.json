{
  "name": "create-boilerplate-app",
  "version": "0.0.1",
  "description": "React 애플리케이션을 빠르게 생성할 수 있는 CLI 도구",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "eslint . --fix",
    "dev": "node dist/index.js",
    "copy-templates": "node scripts/copy-templates.js",
    "build:dev": "ncc build ./src/index.ts -w -o dist/ & npm run copy-templates",
    "build": "ncc build ./src/index.ts -o ./dist/ --minify --no-cache --no-source-map-register && npm run copy-templates"
  },
  "files": [
    "dist",
    "templates"
  ],
  "bin": {
    "create-boilerplate-app": "./dist/index.js"
  },
  "keywords": [
    "create",
    "boilerplate",
    "react",
    "vite",
    "typescript",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@boilerplate/ts-config": "workspace:*"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:^",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22",
    "@types/prompts": "^2.4.9",
    "@types/validate-npm-package-name": "^4.0.2",
    "@vercel/ncc": "^0.38.4",
    "chalk": "^5.6.2",
    "cross-spawn": "^7.0.6",
    "eslint": "^8.57.1",
    "fs-extra": "^11.3.2",
    "prompts": "^2.4.2",
    "typescript": "^5.9.3",
    "validate-npm-package-name": "^5.0.1"
  },
  "engines": {
    "node": ">=16"
  }
}
