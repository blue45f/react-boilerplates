{
  "name": "@boilerplate/sentry-config",
  "version": "0.0.1-canary.0",
  "type": "module",
  "description": "Shared Sentry configuration for React",
  "main": "index.js",
  "exports": {
    "react": {
      "require": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --fix",
    "build": "rm -rf dist/ && rm -rf esm/ && rollup -c && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --declarationDir dist"
  },
  "keywords": [
    "sentry",
    "config",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@boilerplate/ts-config": "workspace:*"
  },
  "peerDependencies": {
    "@sentry/react": "^8.34.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@boilerplate/rollup-config": "workspace:^",
    "@internal/eslint-config": "workspace:^",
    "eslint": "^8.57.1",
    "rollup": "^4.53.3"
  },
  "publishConfig": {
    "exports": {
      "react": {
        "require": "./dist/index.js",
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      }
    },
    "types": "./dist/index.d.ts"
  }
}