{
  "name": "@boilerplate/vitest-config",
  "version": "1.0.0",
  "description": "Shared Vitest configuration",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./mocks": {
      "import": "./dist/mocks.js",
      "types": "./dist/types/mocks.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types/types.d.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --fix",
    "build": "tsc"
  },
  "keywords": [
    "vitest",
    "config",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@internal/eslint-config": "workspace:^",
    "@testing-library/jest-dom": "^6.9.1",
    "eslint": "^8.57.1",
    "jsdom": "^27.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "jsdom": "^25.0.0 || ^26.0.0 || ^27.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./mocks": "./dist/mocks.js",
      "./types": "./dist/types.js"
    },
    "types": "./dist/index.d.ts"
  }
}