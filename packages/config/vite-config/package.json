{
  "name": "@boilerplate/vite-config",
  "version": "0.0.1",
  "description": "Shared Vite configuration",
  "main": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "require": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --fix",
    "build": "rm -rf dist/ && rm -rf esm/ && rollup -c && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --declarationDir dist"
  },
  "keywords": [
    "vite",
    "config"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@boilerplate/ts-config": "workspace:*"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@boilerplate/browserslist-config": "workspace:^",
    "@boilerplate/rollup-config": "workspace:^",
    "@internal/eslint-config": "workspace:^",
    "eslint": "^8.57.1",
    "rollup": "^4.53.3",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "vite": "^5.4.21",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "rollup-plugin-preserve-directives": "^0.4.0",
    "vite": "^5.4.0",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vite-tsconfig-paths": "^5.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "require": "./dist/index.js",
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      }
    },
    "types": "./dist/index.d.ts"
  }
}