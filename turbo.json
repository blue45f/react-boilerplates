{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": true,
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", "eslint.config.*", "tsconfig.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["src/**/*.{ts,tsx}", "tsconfig.json"]
    },
    "test": {
      "cache": true,
      "inputs": ["src/**/*.{ts,tsx}", "vitest.config.*", "tsconfig.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
