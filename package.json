{
  "name": "boilerplates",
  "version": "1.0.0-canary.0",
  "description": "A modern boilerplate generator for React applications",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "husky || true",
    "tr": "sh ./scripts/turbo.sh",
    "lint": "pnpm tr lint",
    "clean": "sh cleaner.sh",
    "build": "pnpm tr build",
    "knip": "knip"
  },
  "keywords": [
    "boilerplate",
    "react",
    "vite",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22",
    "husky": "^9.1.7",
    "knip": "^5.71.0",
    "lint-staged": "^16.0.0",
    "turbo": "^2.6.1",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,js,jsx,mjs}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.11.0"
}