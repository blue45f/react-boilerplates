{
  "name": "react-boilerplates",
  "version": "1.0.0",
  "private": true,
  "description": "React 프로젝트 보일러플레이트 모노레포 (pnpm 10 workspace + catalog)",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blue45f/react-boilerplates"
  },
  "author": "blue45f",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint -- --fix",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "storybook": "pnpm --filter react-lib run storybook",
    "build-storybook": "pnpm --filter react-lib run build-storybook",
    "e2e": "pnpm -r run e2e",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
